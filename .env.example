# Скопируйте этот файл в .env и при необходимости поменяйте значения.

# Порт. Используется одновременно:
#   - как порт, который слушает сервер внутри контейнера;
#   - как порт, зашиваемый в ссылки, которые прокси отдаёт клиентам
#     (host_name:port внутри плейлиста) - см. host_name ниже;
#   - как порт, публикуемый наружу контейнера (docker-compose ports:).
# Именно поэтому он вынесен сюда в одно место, а не дублируется в
# config.py и docker-compose.yml по отдельности.
IPTV_PROXY_PORT=1200

# На каком адресе хоста опубликован порт прокси:
#   0.0.0.0   - доступен снаружи (по умолчанию; прокси без nginx/Angie);
#   127.0.0.1 - только с самого хоста (прокси за nginx/Angie на этом же
#               хосте; тогда же включите trust_x_forwarded_for в config.py).
# Применяется пересозданием контейнера: docker compose up -d
IPTV_PROXY_BIND=0.0.0.0

# Домен/IP, который подставляется в ссылки, отдаваемые клиентам
# (host_name:port внутри плейлиста), переопределяет host_name из
# config.py. Необязательно - если оставить пустым/закомментированным,
# используется host_name из config.py.
IPTV_PROXY_HOST_NAME=mydomain.com

# Пароль для /admin/ (HTTP Basic Auth - без системы пользователей, один
# общий логин/пароль). Если оставить пустым/закомментированным - /admin/
# ВЫКЛЮЧЕН (отвечает 404).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Адрес панели управления: http://<host_name>:<port>/<ADMIN_PATH>/.
# По умолчанию admin. Нестандартное значение прячет панель от сканеров,
# которые перебирают /admin/. Один сегмент пути: латинские буквы, цифры,
# "-" и "_" (например panel-x7Gk2q). Провайдера с таким ключом создать нельзя.
ADMIN_PATH=admin

# Уровень логов: INFO (по умолчанию) или DEBUG. С DEBUG в лог пишется ещё и
# строка на каждый HTTP-запрос (access-лог), включая каждый сегмент .ts -
# включайте только для отладки.
LOG_LEVEL=INFO
